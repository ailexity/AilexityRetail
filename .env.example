PORT=3000
HOST=0.0.0.0
ADMIN_EMAIL=ailexity.info@gmail.com
ADMIN_PASSWORD=Ariesfab@15
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Ailexity Retail <your-smtp-user@gmail.com>
SESSION_TTL_HOURS=12

# Public address of the app, used for the "Open" button in e-mails (e.g. http://192.168.1.25:3000)
APP_URL=

# AI assistant (header ✦ button). Set any of these — every service you set is tried in turn until one answers, so a busy
# or rate-limited model just hands over to the next. Each *_MODEL is a comma-separated list, tried in order.
#   Google Gemini   free key: https://aistudio.google.com/apikey
#   Groq            free key: https://console.groq.com/keys
#   OpenRouter      free key: https://openrouter.ai/keys  (its ":free" models and the openrouter/free router cost nothing)
#   Ollama          no key: a model running on your own PC or server (https://ollama.com) — store data never leaves the building
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite, gemini-flash-lite-latest, gemini-3.5-flash, gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile, openai/gpt-oss-120b, llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free, google/gemma-4-31b-it:free, nvidia/nemotron-3-super-120b-a12b:free
OLLAMA_URL=
OLLAMA_MODEL=
# Which to ask first (default order: gemini, groq, openrouter, ollama); the others follow as fallbacks. To keep store data on
# your own machine, set only OLLAMA_URL and leave the keys blank.
AI_PROVIDERS=
